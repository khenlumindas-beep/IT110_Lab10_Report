# SmartTrack backend — environment template
# Copy to backend/.env and fill in real values. NEVER commit the real .env.

# ---------- Database ----------
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/smarttrack_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=smarttrack_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ---------- JWT ----------
# Production: generate with  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Application ----------
APP_NAME=SmartTrack
APP_VERSION=1.0.0
# Production MUST set DEBUG=false (disables uvicorn reload and enables production log level)
DEBUG=false
# JSON array. Production example: ["https://smarttrack.csucc.edu.ph"]
CORS_ORIGINS=["http://localhost"]

# ---------- File upload ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# ---------- SMTP (optional) ----------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------- ML / risk ----------
MODEL_PATH=./models
RISK_THRESHOLD=0.6
